# Real secrets for the staging/pre-prod stack - replace before first deploy, don't reuse dev
# defaults. Loaded explicitly (see docker-compose.staging.yml's header comment), Compose does not
# pick this up automatically since it isn't named plain ".env".

# openssl rand -base64 48
JWT_SECRET=changeme-generate-a-real-secret-for-staging
JWT_EXPIRATION=3600000

# At-rest encryption of stored secrets (SSO client secrets, import/VCS/webhook tokens).
# openssl rand -base64 48 - and keep it stable: changing it makes already-stored secrets unreadable.
CREDENTIAL_ENCRYPTION_KEY=changeme-generate-a-real-key-for-staging

# The public hostname caddy gets a Let's Encrypt cert for and terminates HTTPS on - must actually
# resolve to this host's IP. A real domain, or a free wildcard-DNS one like <this-host's-ip>.sslip.io
# (no registration needed - see Caddyfile.staging).
DOMAIN=changeme.sslip.io

# Same-origin through caddy (see Caddyfile.staging) means the browser never sends a cross-origin
# request in the first place - this is really only a defense-in-depth backstop, but keep it in sync
# with DOMAIN anyway.
CORS_ALLOWED_ORIGINS=https://changeme.sslip.io

# Baked into the frontend JS bundle at build time (see ./build.sh) - deliberately left empty by
# default now that caddy fronts both api/front on one origin (path-based), so the frontend just
# calls relative /api/... URLs against whatever origin it's served from. Only set this to an
# absolute URL if front is ever served from a different origin than the API sits behind.
FRONT_API_HOST=

# Which locally built image tags to run - see ./build.sh.
API_IMAGE_TAG=latest
FRONT_IMAGE_TAG=latest
